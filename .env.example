# Supabase Production DB Configuration
NEXT_PUBLIC_SUPABASE_URL=https://api.max-dashboard.shop
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Daily Report Email Configuration
# 수신인 이메일 (기본값: on_gv@gatevision.co.kr)
REPORT_RECIPIENT_EMAIL=on_gv@gatevision.co.kr

# 발송 방식 옵션 1: 사내/네이버/지메일 SMTP 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="게이트비전 AI 챗봇 센터" <your_email@gmail.com>

# 발송 방식 옵션 2: Resend API (선택사항, 설정 시 SMTP보다 우선 작동)
# RESEND_API_KEY=re_xxxx...
